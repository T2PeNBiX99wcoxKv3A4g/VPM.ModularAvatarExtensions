<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Toggle label="label.param_only_object.reverse" binding-path="reverse" name="reverse"/>
    <ui:ListView name="paramDatas" show-add-remove-footer="true" header-title="paramDatas" reorderable="true"
                 selection-type="Multiple" show-alternating-row-backgrounds="ContentOnly"
                 virtualization-method="DynamicHeight" show-border="true" binding-path="paramDatas"
                 show-bound-collection-size="false" reorder-mode="Animated"/>
</ui:UXML>
