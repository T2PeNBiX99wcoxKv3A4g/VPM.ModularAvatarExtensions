<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <io.github.ykysnk.ModularAvatarExtensions.Editor.UIElements.ValidatedObjectField
            label="label.constraint_disabler.constraint" error-message="label.constraint_disabler.constraint_error"
            binding-path="constraint" type="UnityEngine.Component, UnityEngine.CoreModule" name="constraint"/>
    <ui:Toggle label="label.constraint_disabler.is_active" binding-path="isActive" name="stopDisable"/>
    <ui:HelpBox message-type="Info" name="info" text="label.constraint_disabler.info"/>
</ui:UXML>
