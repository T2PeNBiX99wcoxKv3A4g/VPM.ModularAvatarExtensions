<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Template name="PhysBoneRootTransformPathEditorListView"
                 src="project://database/Packages/io.github.ykysnk.modular-avatar-extensions/Editor/PhysBoneRootTransformPathEditorListView.uxml?fileID=9197481963319205126&amp;guid=5ac84edbafd02bb44aa061865e54f763&amp;type=3#PhysBoneRootTransformPathEditorListView"/>
    <uie:ObjectField label="label.root_transform_path_base.phys_bone.component"
                     type="UnityEngine.Component, UnityEngine.CoreModule" binding-path="component" name="component"/>
    <ui:HelpBox name="componentNotFound" message-type="Error"
                text="label.root_transform_path_base.component_not_found"/>
    <uie:PropertyField name="reference" binding-path="reference" label="label.root_transform_path_base.root_transform"/>
    <ui:Instance template="PhysBoneRootTransformPathEditorListView" name="ignoreTransformsReferences">
        <AttributeOverrides element-name="references" binding-path="ignoreTransformsReferences"/>
        <AttributeOverrides element-name="set" binding-path="setIgnoreTransforms"/>
        <AttributeOverrides element-name="propName" text="label.phys_bone_root_transform_path.ignore_transforms"/>
    </ui:Instance>
    <ui:Instance template="PhysBoneRootTransformPathEditorListView" name="colliderReferences">
        <AttributeOverrides element-name="references" binding-path="colliderReferences"/>
        <AttributeOverrides element-name="set" binding-path="setColliders"/>
        <AttributeOverrides element-name="propName" text="label.phys_bone_root_transform_path.colliders"/>
    </ui:Instance>
</ui:UXML>
